# Cosmetic only — used for the startup banner. Uploaded media no longer
# embeds this value, so changing it can never orphan an image row.
BASE_URL=http://localhost
PORT=5000
DATABASE_URL="postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require"
# Set to `production` on a deployed host: it enables the request rate
# limiter, which is disabled outside production.
NODE_ENV=development

JWT_SECRET=5EC7CEFA1BE7C9354A639369A2AA8
JWT_EXPIRATION_TIME=2592000 // 30 Days, in seconds
REFRESH_TOKEN_SECRET=CB2A9F14E7D3B6058C1A4F9E2D7B3C8A5F0E1D4C7B9A2F6E3D8C5B1A4F7E0D
REFRESH_TOKEN_EXPIRATION_TIME=2592000 // 30 Days, in seconds

SALT_ROUNDS=10

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

MAX_JSON_SIZE=50mb
MAX_FILE_SIZE=52428800 //1 MB = 1,048,576 bytes, so for 50 MB, the value should be 50 * 1024 * 1024, which equals 52,428,800 bytes
URL_ENCODED=true

REQUEST_LIMIT_TIME=900000 // 15 Min, in ms
REQUEST_LIMIT_NUMBER=3000 // Per 15 Min 3000 Request Allowed
WEB_CACHE=false

# `local` writes to public/uploads — fine for development, but a container
# filesystem on Render/Heroku is wiped on every deploy and restart, so files
# vanish while the database row survives. Use `cloudinary` anywhere hosted.
# Selecting `cloudinary` without all three credentials below refuses to boot.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
