{
  "name": "express-mongo-ts-app-boilerplate",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npm install --include=dev && npx prisma generate && tsc",
    "dev": "ts-node --transpile-only src/app.ts",
    "start:dev": "nodemon --exec ts-node --transpile-only src/app.ts",
    "start": "node dist/app.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "prettier": "prettier --check 'src/**/*.{ts,tsx}'",
    "prettier:fix": "prettier --write 'src/**/*.{ts,tsx}'",
    "test": "for f in tests/*.test.ts; do echo \"\u2500\u2500 $f\"; npx ts-node --transpile-only \"$f\" || exit 1; done",
    "resource": "node ./.bin/raw-cli.js resource",
    "test:phase": "npx ts-node --transpile-only"
  },
  "bin": {
    "resource": "./bin/raw-cli.js"
  },
  "keywords": [
    "typescript",
    "express",
    "express-fileupload",
    "prisma",
    "postgresql",
    "bcrypt",
    "cookie-parser",
    "cors",
    "dotenv",
    "express-mongo-sanitize",
    "express-rate-limit",
    "helmet",
    "hpp",
    "jsonwebtoken",
    "morgan",
    "nodemailer",
    "validator",
    "zod"
  ],
  "author": "Joy Sarkar",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.21.0",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "socket.io": "^4.8.3",
    "validator": "^13.15.26",
    "zod": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-fileupload": "^1.5.1",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^7.0.4",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "commander": "^14.0.2",
    "eslint": "9.x",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "prisma": "^5.21.0",
    "readline": "^1.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
